# i3blocks config - GNOME integration

separator_block_width=15
markup=pango

# Battery Info
[battery]
command=echo "$(upower -i $(upower -e | grep BAT) | grep -E 'state|to full|percentage')" 
interval=30

# Network Info
[network]
command=nmcli device status | grep -E 'ethernet|wifi' | awk '{print $1, $3}'
interval=60

# CPU Usage
[cpu]
command=awk -v FS='[ :]+' '/cpu / {usage=100-$8; printf "CPU: %.1f%%", usage}' /proc/stat
interval=5

# Memory Info
[memory]
command=free -h | grep Mem | awk '{printf "Mem: %s/%s", $3, $2}'
interval=persist

# Date and Time
[date]
command=date '+%Y-%m-%d %H:%M'
interval=60
