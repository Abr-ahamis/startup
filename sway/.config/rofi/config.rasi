configuration {
    modi: "drun,run,window,ssh";
    show-icons: true;
    display-drun: "Apps";
    display-run: "Run";
    display-window: "Windows";
    display-ssh: "SSH";
    drun-display-format: "{name}";
    matching: "fuzzy";
    sort: true;
    case-sensitive: false;
    terminal: "foot";
}

@theme "style.rasi"
