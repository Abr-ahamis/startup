@import "colors.rasi"
@import "fonts.rasi"

* {
    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 720px;
    border-radius: 18px;
    background-color: @transparent-bg;
    border: 2px;
    border-color: @border;
}

mainbox {
    spacing: 0;
    padding: 18px;
    background-color: transparent;
}

inputbar {
    spacing: 10px;
    padding: 0 0 12px 0;
    children: [prompt, entry];
    background-color: transparent;
}

prompt, entry, element-text, element-icon {
    text-color: @fg;
}

prompt {
    padding: 8px 10px;
    border-radius: 999px;
    background-color: rgba(255,255,255,0.08);
}

entry {
    padding: 8px 12px;
    border-radius: 999px;
    background-color: rgba(255,255,255,0.08);
    placeholder-color: @fg-muted;
}

listview {
    lines: 10;
    columns: 1;
    spacing: 6px;
    cycle: false;
    dynamic: true;
    scrollbar: false;
}

element {
    padding: 8px 12px;
    border-radius: 12px;
    background-color: transparent;
}

element selected {
    background-color: rgba(42, 109, 244, 0.26);
    text-color: #ffffff;
}

element-icon {
    size: 20px;
}

message {
    padding: 8px 0 0;
}
