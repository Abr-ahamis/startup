# i3blocks config - GNOME-style

separator_block_width=15
markup=pango

#[time]
#command=~/.config/i3blocks/scripts/time.sh
#interval=persist

[network]
command=~/.config/i3blocks/scripts/network.sh
interval=1

[memory]
command=~/.config/i3blocks/scripts/memory.sh
interval=persist


[cpu]
command=~/.config/i3blocks/scripts/cpu.sh
interval=persist
min_width=CPU: 100%

#[disk]
#command=~/.config/i3blocks/scripts/disk.sh
#interval=60

[date]
command=~/.config/i3blocks/scripts/date.sh
interval=persist

[Unit]
Description=Battery monitor notifications

[Service]
Type=simple
ExecStart=%h/.local/bin/battery-monitor.sh
Restart=always
RestartSec=5

[Install]
WantedBy=default.target


