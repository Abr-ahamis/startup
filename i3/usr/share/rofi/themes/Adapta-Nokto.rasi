/*******************************************************************************
 * ROFI Transparent Theme with Transparent Selection
 ********************************************************************************/

* {
    foreground:                  rgba(255, 255, 255, 1);  /* text color */
    text-color:                  @foreground;
    background-color:            rgba(0, 0, 0, 0);      /* fully transparent */
    border:                      0;
    spacing:                     2;
}

window {
    background-color: rgba(0, 0, 0, 0);
    border:           0;
    padding:          0;
}

mainbox {
    border:  0;
    padding: 0;
}

message {
    border: 0;
    padding: 0;
}

textbox {
    text-color: @foreground;
}

listview {
    fixed-height: 0;
    border: 0;
    spacing: 2px;
    scrollbar: false;
    padding: 0;
}

element {
    border: 0;
    padding: 0;
    background-color: rgba(0,0,0,0);
    text-color: @foreground;
}

element-text {
    background-color: inherit;
    text-color: inherit;
}

/* Normal elements */
element normal.normal,
element.normal.urgent,
element.normal.active,
element.alternate.normal,
element.alternate.urgent,
element.alternate.active {
    background-color: rgba(0,0,0,0);
    text-color: @foreground;
}

/* Selected element with transparent highlight */
element.selected.normal,
element.selected.urgent,
element.selected.active {
    background-color: rgba(255, 255, 255, 0.1); /* subtle transparent highlight */
    text-color: @foreground;
}

scrollbar {
    width: 0;
    border: 0;
    handle-width: 0;
    padding: 0;
}

mode-switcher {
    border: 0;
}

button.selected {
    background-color: rgba(255, 255, 255, 0.1);
    text-color: @foreground;
}

inputbar,
case-indicator,
entry,
prompt,
textbox-prompt-colon {
    text-color: @foreground;
    spacing: 0;
    padding: 0;
}

inputbar {
    children: [ prompt, textbox-prompt-colon, entry, case-indicator ];
}

textbox-prompt-colon {
    expand: false;
    str: ":";
    margin: 0;
    text-color: @foreground;
}
